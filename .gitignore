# ---- Data & run artifacts (regenerated by running the experiments) ----
# raw activations, cosine traces, plots, vector_cache (multi-GB).
# NOTE: `results/*`, not `results/` — git does not descend into an excluded
# directory, so the negations below would be dead under `results/`.
results/*
# ...except the small derived scoring artifacts, which are the figure scripts'
# inputs and the only way to regenerate the paper's figures from a clone.
!results/SCORES_*.json
!results/PROFILES_*.json
!results/SCALAR_CI_*.json
!results/ONSET_OFFSET_WORD_*.json
!results/FIGDATA_*.json
# Olmo 3 7B snapshot rerun store (403 GB of raw runs + derived JSONs, local only)
results-olmo7b-rerun-20260814/
# postprocess orchestrator lock (transient)
.postprocess.lock
# Weights & Biases run logs
wandb/
# launcher logs
logs/
# rendered paper figures (regenerated by figure_scripts/)
Figures/
# stray run logs
*.log

# ---- Environment ----
.venv/
venv/
# HF_TOKEN / WANDB_API_KEY live here (never commit)
.env
# cached concept vectors / tensors
*.pt

# ---- Python ----
__pycache__/
*.py[cod]
*.egg-info/
.ipynb_checkpoints/

# ---- Markdown docs (working notes / generated writeups kept out of the repo) ----
# Ignore all markdown EXCEPT the README (the repo's front page).
*.md
!README.md
# the generated compliance report (see compliance/build_compliance_table.py)
!compliance/*.md

# ---- Editor / OS / tooling ----
.vscode/
.claude/settings.local.json
.DS_Store

