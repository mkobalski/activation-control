# ---- Data & run artifacts (regenerated by running the experiments) ----
results/            # raw activations, cosine traces, plots, vector_cache (multi-GB)
wandb/              # Weights & Biases run logs
logs/               # launcher logs
*.log               # stray run logs

# ---- Environment ----
.venv/
venv/
.env                # HF_TOKEN / WANDB_API_KEY live here (never commit)
*.pt                # cached concept vectors / tensors

# ---- Python ----
__pycache__/
*.py[cod]
*.egg-info/
.ipynb_checkpoints/

# ---- Markdown docs (working notes / generated writeups kept out of the repo) ----
# Ignore all markdown EXCEPT the README (the repo's front page).
*.md
!README.md

# ---- Editor / OS / tooling ----
.claude/settings.local.json
.DS_Store
